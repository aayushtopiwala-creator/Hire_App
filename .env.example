# Copy to .env.local and fill in. .env.local is git-ignored.

# Supabase — service role key is used server-side only (never shipped to the browser).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: Postgres connection string, lets `npm run db:migrate` apply the schema for you.
# Otherwise paste supabase/migrations/0001_init.sql into the Supabase SQL editor.
DATABASE_URL=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Resend — Confirm & Send is the only code path that uses these.
RESEND_API_KEY=your_resend_api_key_here
# Without a verified domain, Resend only allows onboarding@resend.dev -> your own account email.
EMAIL_FROM=Arjun Mehta <onboarding@resend.dev>
# While set, EVERY confirmed send goes to this address instead of the candidate. Remove to go live.
EMAIL_TEST_RECIPIENT=

# Default size of the interview shortlist per role.
TOP_N_DEFAULT=5

# Draft sign-off, filled in locally (never sent to Gemini). Use \n for a line break.
SENDER_SIGNATURE=Arjun Mehta\nFounder, Kargo
